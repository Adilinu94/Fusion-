<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest gemaess Berechtigungstabelle in Bauplan Abschnitt 4:
  READ_MEDIA_AUDIO/READ_EXTERNAL_STORAGE liegen im Manifest von
  :data:library, die Media-Playback-FGS-Deklarationen samt Service in
  :data:playback; der Merger fuehrt sie hier zusammen. POST_NOTIFICATIONS
  folgt mit Schritt 8/12.

  Auto Backup ist deaktiviert (Bauplan 2.3), damit Trainings- und
  Bibliotheksmetadaten nicht unbemerkt in einen Cloud-Backupdienst gelangen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".DropSyncApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DropSync"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
