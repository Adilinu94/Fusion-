<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest gemaess Berechtigungstabelle in Bauplan Abschnitt 4:
  READ_MEDIA_AUDIO/READ_EXTERNAL_STORAGE liegen im Manifest von
  :data:library, die Media-Playback-FGS-Deklarationen samt Service in
  :data:playback, READ_HEART_RATE in :data:health; der Merger fuehrt sie
  hier zusammen. POST_NOTIFICATIONS folgt mit Schritt 8/12.

  Auto Backup ist deaktiviert (Bauplan 2.3), damit Trainings- und
  Bibliotheksmetadaten nicht unbemerkt in einen Cloud-Backupdienst gelangen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lint-Phase 11: VIBRATE fuer den Timer-Haptikadapter (Schutzklasse
         normal, keine Laufzeitabfrage noetig). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DropSyncApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DropSync"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Begruendungsseite fuer die Health-Connect-Berechtigung
          (Herzfrequenz-Plan Abschnitt 7). Health Connect verlangt sie als
          Voraussetzung fuer den Berechtigungsdialog und startet sie selbst,
          deshalb exported="true"; die Seite zeigt nur Text und liest keine
          Daten. Die Permission selbst liegt im Manifest von :data:health.

          Zwei Intent-Filter, weil Android die Deklaration je Version
          unterschiedlich erwartet: ACTION_SHOW_PERMISSIONS_RATIONALE bis
          Android 13, VIEW_PERMISSION_USAGE mit Kategorie
          HEALTH_PERMISSIONS ab Android 14. Beide zeigen dieselbe Seite.
        -->
        <activity
            android:name=".HealthRationaleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/health_rationale_title"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".HealthRationaleAliasActivity"
            android:exported="true"
            android:targetActivity=".HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
