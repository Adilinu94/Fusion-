    <string name="settings_privacy_section">Privacy</string>
    <string name="settings_privacy_body">FlowRep works entirely offline. There is no analytics, no advertising and no network traffic.</string>
    <string name="settings_rest_music_section">Music during breaks</string>
    <string name="settings_rest_music_desc">Choose how music behaves during your set breaks. Off leaves your normal playback running.</string>
    <string name="settings_rest_music_normal">Off</string>
    <string name="settings_rest_music_normal_desc">Do not interfere. Queue and shuffle carry on as usual.</string>
    <string name="settings_rest_music_rest_playlist">Break playlist</string>
    <string name="settings_rest_music_rest_playlist_desc">A break playlist plays during the break; when it ends, a track from a workout playlist starts.</string>
    <string name="settings_rest_music_drop_landing">Drop landing</string>
    <string name="settings_rest_music_drop_landing_desc">Like the break playlist, and a workout track is timed so its drop hits the end of the break.</string>
    <string name="settings_rest_duck_title">Break music volume: %1$d dB</string>
    <string name="settings_rest_duck_desc">Lowers the music during the break. The countdown cue never ducks twice.</string>
    <string name="settings_timing_hint">Timing adapts to your audio route. Bluetooth devices add latency of their own.</string>
