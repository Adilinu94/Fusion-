    <string name="settings_mix_preset_fade_desc">Smooth, even blend — the classic crossfade.</string>
    <string name="settings_mix_preset_rise_desc">The next track comes in late and rises steeply at the end.</string>
    <string name="settings_mix_preset_blend_desc">Even, unobtrusive blend at a steady pace.</string>
    <string name="settings_mix_preset_wave_desc">Breathing, wave-like swell into the next track.</string>
    <string name="settings_mix_preset_melt_desc">The next track enters early; both melt together for a long time.</string>
    <string name="settings_mix_preset_slam_desc">Hard cut in the middle of the transition, like a DJ cut.</string>
